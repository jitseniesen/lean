import Nsode.Basic
import Nsode.Gronwall

/-! Proofs for general methods -/

def Φ_domain {n : ℕ} (φ : ℝ → Rn n) (a b γ h₀ : ℝ) :
    Set (ℝ × Rn n × ℝ) :=
  {q | q.1 ∈ Set.Icc a b ∧ ‖q.2.1 - φ q.1‖ ≤ γ ∧ q.2.2 ∈ Set.Icc 0 h₀}

-- First prove the theorem under a global Lipschitz constant
theorem global_error_bound' {n : ℕ} (f : ODE n) (φ : ℝ → Rn n) (Φ : Increment n)
    (t₀ T : ℝ) (y₀ : Rn n) (h₀ M N : ℝ) (p : ℕ) (hinit : φ t₀ = y₀) (hM : 0 < M) (hN : 0 < N)
    (hlip : ∀ t y₁ y₂ h, t ∈ Set.Icc t₀ T → h ∈ Set.Ioc 0 h₀
      → ‖Φ f t y₁ h - Φ f t y₂ h‖ ≤ M * ‖y₁ - y₂‖)
    (hloc : ∀ t ∈ Set.Icc t₀ T, ∀ h ∈ Set.Ioc 0 h₀, ‖local_error Φ f φ h t‖ ≤ N * h ^ (p + 1))
    : ∀ h ∈ Set.Ioc 0 h₀, ∀ k : ℕ, k ≥ 1 → t₀ + k * h ≤ T →
        ‖global_error Φ f φ t₀ h k‖ ≤ h ^ p * N * (Real.exp (M * h * k) - 1) / M := by
  intro h hh k hk ht
  -- Let τ i = t₀ + i * h
  let τ := (fun i : ℕ => t₀ + i * h)
  -- We need to show that τ i stays within the interval [t₀, T] for i < k
  have hτ : ∀ i < k, τ i ∈ Set.Icc t₀ T := by
    intro i hi
    rw [Set.mem_Icc]
    dsimp [τ]
    constructor
    · have : 0 ≤ (i : ℝ) * h := mul_nonneg (show 0 ≤ (i : ℝ) by positivity) (le_of_lt hh.1)
      nlinarith
    · have hi_real : (i : ℝ) < k := by exact_mod_cast  hi
      have : i * h < k * h := mul_lt_mul_of_pos_right hi_real hh.1
      nlinarith
  -- Let θ i be the sequence generated by the increment function Φ
  let θ := numerical_method Φ f t₀ y₀ h
  -- Let y i be the exact solution evaluated at τ i
  let y := fun i : ℕ => φ (τ i)
  -- The global error is then defined as e i = θ i - y i
  let e := fun i : ℕ => θ i - y i
  have e_eq_global_error: ∀ i, e i = global_error Φ f φ t₀ h i := by
    intro i
    dsimp [global_error, e, τ, θ, y]
    simp only [hinit]
  -- We can derive a recursion relation for the global error
  have e_recursion : ∀ i : ℕ, e (i + 1) = e i + h • (Φ f (τ i) (θ i) h - Φ f (τ i) (y i) h)
                                              + h • Φ f (τ i) (y i) h - (y (i + 1) - y i) := by
    intro i
    rw [e_eq_global_error, e_eq_global_error]
    dsimp [global_error, numerical_method, y, τ, θ]
    simp only [hinit]
    rw [smul_sub]
    ring_nf
  -- Bound h * (Φ f (t i) (θ i) h - Φ f (t i) (y i) h) using the Lipschitz property
  have bound1 : ∀ i < k, ‖h • (Φ f (τ i) (θ i) h - Φ f (τ i) (y i) h)‖ ≤ h * M * ‖e i‖ := by
    intro i hi
    simp only [norm_smul, Real.norm_eq_abs]
    have hlip' := hlip (τ i) (θ i) (y i) h (hτ i hi) hh
    simp only [e]
    rw [abs_of_pos hh.1]
    calc h * ‖Φ f (τ i) (θ i) h - Φ f (τ i) (y i) h‖
      _ ≤ h * (M * ‖θ i - y i‖) := mul_le_mul_of_nonneg_left hlip' (le_of_lt hh.1)
      _ = h * M * ‖e i‖ := by dsimp [e]; ring
  -- Bound h • Φ f (τ i) (y i) h - (y (i + 1) - y i) using the local error bound
  have bound2 : ∀ i < k, ‖h • Φ f (τ i) (y i) h - (y (i + 1) - y i)‖ ≤ N * h ^ (p + 1) := by
    intro i hi
    have hloc' := hloc (τ i) (hτ i hi) h hh
    convert hloc'
    dsimp [local_error, numerical_method, τ, y]
    push_cast
    ring_nf
  -- Derive a recursive bound for the global error
  have h_rec : ∀ i < k, ‖e (i + 1)‖ ≤ (1 + h * M) * ‖e i‖ + N * h ^ (p + 1) := by
    intro i hi
    calc ‖e (i + 1)‖
    _ = ‖e i + h • (Φ f (τ i) (θ i) h - Φ f (τ i) (y i) h)
             + h • Φ f (τ i) (y i) h - (y (i + 1) - y i)‖ := by rw [e_recursion i]
    _ = ‖e i + h • (Φ f (τ i) (θ i) h - Φ f (τ i) (y i) h)
             + (h • Φ f (τ i) (y i) h - (y (i + 1) - y i))‖ := by congr; ring
    _ ≤ ‖e i + h • (Φ f (τ i) (θ i) h - Φ f (τ i) (y i) h)‖
          + ‖h • Φ f (τ i) (y i) h - (y (i + 1) - y i)‖ := by apply norm_add_le
    _ ≤ ‖e i‖ + ‖h • (Φ f (τ i) (θ i) h - Φ f (τ i) (y i) h)‖
              + ‖h • Φ f (τ i) (y i) h - (y (i + 1) - y i)‖ := by
      apply add_le_add_left
      apply norm_add_le
    _ ≤ ‖e i‖ + h * M * ‖e i‖ + ‖h • Φ f (τ i) (y i) h - (y (i + 1) - y i)‖ := by
      apply add_le_add_left
      apply add_le_add_right
      apply bound1 i hi
    _ ≤ ‖e i‖ + h * M * ‖e i‖ + N * h ^ (p + 1) := by
      apply add_le_add_right
      apply bound2 i hi
    _ = (1 + h * M) * ‖e i‖ + N * h ^ (p + 1) := by ring
  -- Now apply the discrete Gronwall inequality
  have h_gronwall : ∀ i ≤ k, ‖e i‖ ≤ N * h ^ p * (Real.exp (i * h * M) - 1) / M := by
    have ineq1 : h * M > 0 := mul_pos hh.1 hM
    have ineq2 : N * h ^ (p + 1) ≥ 0 := le_of_lt (mul_pos hN (pow_pos hh.1 (p + 1)))
    have h_gronwall' := gronwall_bound ineq1 ineq2 h_rec
    intro i hi
    convert h_gronwall' i hi
    have : e 0 = 0 := by dsimp [e, θ, y, τ, numerical_method]; simp [hinit]
    rw [this]
    simp only [norm_zero]
    field_simp [ne_of_gt hh.1]
    ring
  -- The bound on ‖e i‖ translates to the bound on the global error as stated in the theorem.
  calc
    ‖global_error Φ f φ t₀ h k‖ = ‖e k‖ := by rw [← e_eq_global_error k]
    _ ≤ N * h ^ p * (Real.exp (k * h * M) - 1) / M := h_gronwall k (le_refl k)
    _ = N * h ^ p * (Real.exp (M * h * k) - 1) / M := by congr 4; ring
    _ = h ^ p * N * (Real.exp (M * h * k) - 1) / M := by ring

